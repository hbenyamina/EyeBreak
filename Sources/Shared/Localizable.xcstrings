  "sourceLanguage": "en",
  "strings": {
    "\"5 More Minutes\" holds a break back without skipping it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«تأجيل ٥ دقائق» يؤخّر الاستراحة دون أن تُحتسب متخطّاة."
          }
        }
      }
    },
