    "%lld breaks skipped in a row. Screens cut blinking by about two thirds; this one takes %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستراحات المتخطّاة على التوالي: %1$lld. تقلّل الشاشات الرمش بنحو الثلثين، وتستغرق هذه الاستراحة %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld breaks skipped in a row. Screens cut blinking by about two thirds; this one takes %2$@."
